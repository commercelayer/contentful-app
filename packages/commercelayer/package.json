{
  "name": "commercelayer",
  "version": "1.2.0",
  "private": false,
  "dependencies": {
    "@commercelayer/js-auth": "^8.0.1",
    "@commercelayer/sdk": "^6.58.0",
    "@contentful/app-sdk": "^4.69.0",
    "@contentful/f36-components": "^4.81.1",
    "@contentful/f36-icons": "^4.29.1",
    "@contentful/f36-utils": "^4.24.3",
    "@contentful/f36-workbench": "^4.21.1",
    "@contentful/forma-36-fcss": "^0.3.5",
    "@contentful/forma-36-tokens": "^0.11.2",
    "@emotion/css": "^11.13.5",
    "contentful-management": "^11.76.0",
    "js-cookie": "^3.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-app-definition": "contentful-app-scripts create-app-definition",
    "upload": "contentful-app-scripts upload --bundle-dir ./build",
    "upload-ci": "contentful-app-scripts upload --ci --bundle-dir ./build  --organization-id $CONTENTFUL_ORG_ID --definition-id $CONTENTFUL_APP_DEF_ID --token $CONTENTFUL_ACCESS_TOKEN"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@contentful/app-scripts": "^1.33.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
